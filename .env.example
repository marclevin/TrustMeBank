# Copy to .env and adjust. Every value has a development default except the two secrets,
# which you must change before exposing TrustMeBank to a class.

# PostgreSQL connection. The docker-compose file provides a matching `db` service.
DATABASE_URL=postgresql+psycopg://trustmebank:trustmebank@db:5432/trustmebank
POSTGRES_PASSWORD=trustmebank

# Signs the session cookie. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Password for the /admin interface.
ADMIN_PASSWORD=change-me

# The URL students use to reach TrustMeBank. Used in authorisation_url and the OpenAPI servers list.
PUBLIC_BASE_URL=http://localhost:8000

# Seed customers, accounts and the demo application on first start if the database is empty.
SEED_ON_STARTUP=true

# Refuse payments and transfers that would take a balance below zero (system accounts excepted).
ALLOW_NEGATIVE_BALANCES=false

# Token and consent lifetimes.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
CONSENT_TTL_DAYS=90

# Hold approved payments in PROCESSING for this many seconds before settling. 0 settles
# immediately in the approval request. Raise it (for example 20) to make students handle
# asynchronous settlement through webhooks or polling.
PAYMENT_PROCESSING_DELAY_SECONDS=0

# Background thread that delivers webhooks and settles delayed payments.
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_TIMEOUT_SECONDS=10

# Set to true when TrustMeBank is served over HTTPS.
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
